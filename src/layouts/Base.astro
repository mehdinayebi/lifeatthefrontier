---
import '../styles/tokens.css';
import '../styles/base.css';
import { site } from '../content/site';

interface Props {
  title?: string;
  description?: string;
  /** Path for the canonical link, e.g. "/" or "/privacy". Omit on the 404 page. */
  path?: string;
  /** Keep placeholder pages out of search results until their text is supplied. */
  noindex?: boolean;
  /** Where the skip link goes. */
  skipTo?: string;
}
const {
  title = site.meta.title,
  description = site.meta.description,
  path,
  noindex = false,
  skipTo = 'content',
} = Astro.props;
const m = site.meta;
const canonical = path ? new URL(path, site.url).href : undefined;
const ogImage = new URL(m.ogImage, site.url).href;

/* Structured data (schema.org JSON-LD): tells search engines and AI assistants what the
   show is, who hosts it and what it covers. Only facts that are on the site. */
const abs = (p: string) => new URL(p, site.url).href;
const home = abs('/');
const ids = { site: `${home}#website`, org: `${home}#organization`, host: `${home}#host` };
const sameAs = site.footer.follow.platforms.map((p) => p.url).filter(Boolean);
const graph: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    '@id': ids.site,
    url: home,
    name: site.name,
    alternateName: site.shortName,
    description: m.description,
    inLanguage: site.lang,
    publisher: { '@id': ids.org },
  },
  {
    '@type': 'Organization',
    '@id': ids.org,
    name: site.name,
    alternateName: site.shortName,
    url: home,
    description: site.footer.line,
    slogan: site.hero.line,
    logo: { '@type': 'ImageObject', url: abs(site.seo.logo), width: 512, height: 512 },
    image: ogImage,
    email: site.footer.contact.email || undefined,
    founder: { '@id': ids.host },
    knowsAbout: site.seo.topics,
    publishingPrinciples: abs('/editorial-standards'),
    ...(sameAs.length ? { sameAs } : {}),
  },
  {
    '@type': 'Person',
    '@id': ids.host,
    name: site.host.name,
    jobTitle: 'Host',
    description: site.host.bio,
    url: `${home}#host`,
    ...(site.host.portrait3x ? { image: abs(site.host.portrait3x) } : {}),
    worksFor: { '@id': ids.org },
  },
];
if (canonical) {
  graph.push({
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: title,
    description,
    inLanguage: site.lang,
    isPartOf: { '@id': ids.site },
    about: { '@id': ids.org },
    primaryImageOfPage: { '@type': 'ImageObject', url: ogImage, width: m.ogImageWidth, height: m.ogImageHeight },
  });
}
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta name="author" content={site.host.name} />

    <link rel="preload" href="/fonts/instrument-sans-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-sans-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content={m.themeColor} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={m.ogTitle} />
    <meta property="og:description" content={m.ogDescription} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(m.ogImageWidth)} />
    <meta property="og:image:height" content={String(m.ogImageHeight)} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={site.name} />
    <meta property="og:locale" content="en" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={m.xHandle} />
    <meta name="twitter:title" content={m.ogTitle} />
    <meta name="twitter:description" content={m.ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={site.name} />

    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <div id="top" class="lf">
      <a class="lf-skip" href={`#${skipTo}`}>{site.skipLink}</a>
      <slot />
    </div>
    <slot name="end" />
  </body>
</html>
