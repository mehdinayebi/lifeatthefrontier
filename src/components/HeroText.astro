---
/*
 * The hero's text, rendered twice from this one source so the two layers can never
 * drift apart: once as the real content, once as the world layer's visual copy.
 * The copy uses a div instead of a second h1 and a span instead of a second link.
 */
import { site } from '../content/site';

interface Props {
  copy?: boolean;
}
const { copy = false } = Astro.props;
const [first, second] = site.hero.titleLines;
const Title = copy ? 'div' : 'h1';
---
<div class="lf-side">
  <Title class="lf-h1"><span class="lf-ln"><span class="lf-w">{first}</span></span> <span class="lf-ln"><span class="lf-w">{second}<span class="lf-o lf-stop">.</span></span></span></Title>
  <p class="lf-tag">{site.hero.line}</p>
  {copy ? <span class="lf-cta">{site.hero.button}</span> : <a class="lf-cta" href="#subscribe">{site.hero.button}</a>}
</div>
