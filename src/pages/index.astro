---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Frontiers from '../components/Frontiers.astro';
import Lens from '../components/Lens.astro';
import FrontierTest from '../components/FrontierTest.astro';
import Host from '../components/Host.astro';
import Newsletter from '../components/Newsletter.astro';
import Footer from '../components/Footer.astro';
import motion from '../scripts/motion.js?raw';
---
<Base path="/" skipTo="frontiers">
  <main>
    <Hero />
    <Frontiers />
    <Lens />
    <FrontierTest />
    <Host />
    <Newsletter />
  </main>
  <Footer />
  <script is:inline slot="end" set:html={motion} />
</Base>
